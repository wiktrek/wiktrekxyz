---
import "../styles/global.css";
import { getCollection } from "astro:content";
import sortPosts from "~/utils/sortPosts";
export interface Props {
  title: string;
}
const { title } = Astro.props;
const blogPosts = sortPosts(await getCollection("blog")).map(({ id, data }) => ({
  id,
  title: data.title,
}));
import NavBar from "~/components/NavBar";
import KeyboardShortcuts from "~/components/KeyboardShortcuts";
import { Toaster } from "~/components/ui/toaster";
import { ClientRouter } from "astro:transitions";
---

<html lang="en" translate="no">
  <head>
    <meta charset="UTF-8" /><meta
      name="description"
      content="wiktrek's website"
    />
    <meta name="msvalidate.01" content="BDA24E1E4A734EE0DC05033EFEDA63E5" />
    <meta
      name="keywords"
      content="wiktrek, wiktrek.xyz, wiktrek website, wiktor, wiktorek, xyz, wiktrek xyz, wiktor, wiktorek, wiktorek website, wiktor website, wiktrek.com, wiktrek.pl, wiktrek.org, wiktrek.net,software,programming,next.js,react,rust,typescript"
    />
    <meta name="viewport" content="width=device-width" /><link
      rel="icon"
      href="/favicon.svg"
    />
    <link rel="sitemap" href="/sitemap.xml" /><meta
      name="generator"
      content={Astro.generator}
    />
    <title>{title}</title>
    <ClientRouter />
  </head>
  <body class="font-bold bg-background">
    <NavBar client:only="react" />
    <slot />
    <KeyboardShortcuts client:only="react" blogPosts={blogPosts} />
    <Toaster client:idle />
  </body>
</html>
